{
  "expo": {
    "name": "Caserito",
    "slug": "caserito",
    "scheme": "caserito",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3E6CC",
    "android": {
      "package": "cl.caserito.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "cl.caserito.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Caserito usa tu ubicación para mostrarte los drops del barrio a pocas cuadras."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Caserito usa tu ubicación para mostrarte los drops del barrio a pocas cuadras."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ad8f9042-40e8-4c50-ad1f-c9075bf93abd"
      }
    },
    "owner": "caseritos-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ad8f9042-40e8-4c50-ad1f-c9075bf93abd"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Caserito",
      "shortName": "Caserito",
      "themeColor": "#FFD100",
      "backgroundColor": "#F3E6CC",
      "lang": "es",
      "description": "Caserito — tu barrio te tiene ofertas. Drops de Barrio Italia."
    }
  }
}
